# pilot-client.env.template
#
# Paste-ready env block for a new pilot tenant. Fill the angle-bracket
# placeholders with values received from Safina + the client + AWS,
# then drop into Coolify UI → ORGON → environment <client-pilot> →
# Environment Variables → Save → Redeploy.
#
# Backup the current values BEFORE editing — Coolify history is per-edit
# but a manual diff saved locally helps if you need to roll back quick.

# ─── From Safina (must-haves) ─────────────────────────────────────────
SAFINA_STUB=0
SAFINA_BASE_URL=https://my.safina.pro/ece/
SAFINA_EC_PRIVATE_KEY=<0x + 64 hex chars — prod EC key issued by Safina for THIS client>

# Optional canonical-payload verification (after sample-tx discovery)
# Three modes: off | shadow | enforce
# Leave off until safina_discover_canonical.py confirms a variant against
# a Safina-issued sample signed-tx. Then run 24h in shadow before flipping
# to enforce.
ORGON_SAFINA_VERIFY_MODE=off
SAFINA_CANONICAL_VARIANT=

# ─── ORGON-side mandatory ─────────────────────────────────────────────
ORGON_ENV=production
ORGON_AUTO_MIGRATE=1
ORGON_AUTO_SEED=0                    # NEVER 1 on a client tenant
ORGON_JSON_LOGS=1
ORGON_PARTNER_REPLAY_OFF=0           # keep replay-guard on

# Generate once with: openssl rand -hex 32
# Keep it persistent — rotating invalidates every signed JWT (logs everyone out).
JWT_SECRET_KEY=<openssl rand -hex 32>

# ─── Signer backend (env for pilot < 1M$ AUM; kms for banks/funds) ────
# `env`   = SAFINA_EC_PRIVATE_KEY held in process memory (acceptable for pilots)
# `kms`   = AWS KMS asymmetric key — see prod-readiness.md §5❶ for AWS setup
# `vault` = stub, raises NotImplementedError
ORGON_SIGNER_BACKEND=env
# If kms:
# AWS_KMS_KEY_ID=alias/orgon-safina-<client>
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=<service account>
# AWS_SECRET_ACCESS_KEY=<service account>

# ─── Sumsub KYC/KYB (optional — pre-launch baseline if all unset) ─────
# When all three are unset, /sumsub/* endpoints return 503 cleanly and
# the frontend shows a "pre-launch — contact support" banner.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_KYB_LEVEL_NAME=basic-kyb-level

# ─── Observability (recommended for prod) ─────────────────────────────
SENTRY_DSN=
# Backup off-site (recommended once tenant has real data)
ORGON_BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID_BACKUP=
AWS_SECRET_ACCESS_KEY_BACKUP=

# ─── Email (optional — falls back to /tmp/orgon_emails.log if unset) ──
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@<client>.com

# ─── Stripe (skip for institutional manual-invoice clients) ───────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# ─── Telegram (optional incident channel) ─────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Public URL ────────────────────────────────────────────────────────
# Coolify auto-resolves these from the assigned domain, but keep here
# for reference. Cloudflare DNS for <client>.asystem.ai → 65.21.205.230,
# orange-cloud proxied, SSL mode = Full (not Flexible — that loops).
ORGON_PUBLIC_URL=https://<client>.asystem.ai
CORS_ORIGINS=https://<client>.asystem.ai
