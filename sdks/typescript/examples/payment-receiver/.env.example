# Public+secret pair from Settings → API ключи
ORGON_KEY=okt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORGON_SECRET=okst_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Long random string. Set on ORGON via PUT /v1/webhooks/config.
WEBHOOK_SECRET=replace-with-long-random-string

# Defaults to https://orgon.asystem.ai
# ORGON_BASE_URL=
PORT=4242
